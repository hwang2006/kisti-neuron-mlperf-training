Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.01-py3

%labels
    Description MLPerf Training Llama 3.1 8B H200
    NeMoVersion v2.1.0
    NeMoRunVersion v0.4.0
    MegatronCoreVersion core_r0.11.0

%files
    requirements.txt /workspace/code/requirements.txt
    callbacks.py /workspace/code/callbacks.py
    pretrain_llama31.py /workspace/code/pretrain_llama31.py
    run_llama31.sh /workspace/code/run_llama31.sh
    config_H200_1x8x1_8b.sh /workspace/code/config_H200_1x8x1_8b.sh
    config_H200_1x2x1_8b.sh /workspace/code/config_H200_1x2x1_8b.sh
    utils /workspace/code/utils
    patches /workspace/code/patches

%post
    set -e

    mkdir -p /workspace/code
    cd /workspace

    # Keep the NGC PyTorch stack fixed.
    python3 - <<'PY'
import importlib.util
import importlib

pkgs = ["torch", "torchvision", "torchaudio"]
lines = []

for p in pkgs:
    if importlib.util.find_spec(p):
        m = importlib.import_module(p)
        lines.append(f"{p}=={m.__version__}")

open("/pip_torch_constraint.txt", "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
PY

    export PIP_CONSTRAINT=/pip_torch_constraint.txt

    pip install numcodecs==0.13.1

    # NeMo
    git clone https://github.com/NVIDIA/NeMo.git
    cd /workspace/NeMo
    git checkout v2.1.0

    pip uninstall -y nemo-toolkit sacrebleu || true

    sed -i '/mamba-ssm/d' requirements/requirements_nlp.txt
    sed -i 's/tensorstore<0.1.46/tensorstore/g' requirements/requirements_nlp.txt
    sed -i 's/protobuf==3.20.3/protobuf/g' requirements/requirements.txt

    pip install "cython<3.0.0"
    pip install -e ".[llm]"
    pip install -e ".[nlp]"

    # NeMo-Run
    cd /workspace
    git clone https://github.com/NVIDIA/NeMo-Run.git
    cd NeMo-Run
    git checkout v0.4.0
    pip install -e .

    # MLPerf Python requirements
    cd /workspace/code
    pip install -r requirements.txt

    # Megatron-Core
    cd /workspace
    pip uninstall -y megatron-core || true

    git clone https://github.com/NVIDIA/Megatron-LM.git
    cd Megatron-LM
    git checkout core_r0.11.0
    pip install .

    cd megatron/core/datasets
    make

%environment
    export PYTHONPATH="/workspace/Megatron-LM:${PYTHONPATH}"
    export PIP_CONSTRAINT=""
    export CUDA_DEVICE_MAX_CONNECTIONS=1

%runscript
    cd /workspace/code
    exec "$@"
